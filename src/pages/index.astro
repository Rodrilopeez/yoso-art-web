---
import Base from '../layouts/Base.astro';
---

<Base title="YOSO — Arte digital, escultura y fotografía | Madrid">
  <main class="container section">
    <p class="eyebrow">Sistema de diseño · rediseño en construcción</p>
    <h1 style="margin-block: 1rem 2rem;">Una arquitectura del&nbsp;ser</h1>
    <hr class="accent-rule" style="margin-bottom: 2rem;" />
    <p class="lead">
      Galería contemporánea de la obra de YOSO. Arte digital, escultura y fotografía
      de carácter onírico que explora la identidad humana.
    </p>

    <div style="margin-top: 4.5rem; display: grid; gap: 1.5rem; border-top: 1px solid var(--c-line); padding-top: 2.5rem;">
      <h2>Fraunces display · titulares</h2>
      <h3>Inter · subtítulos y jerarquía</h3>
      <p>Cuerpo de texto en Inter, peso ligero, interlineado amplio para una lectura editorial. El acento <span style="color: var(--c-accent-2);">oro cálido</span> puntúa la composición sin saturar.</p>
    </div>
  </main>
</Base>
