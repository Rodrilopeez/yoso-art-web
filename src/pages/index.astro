---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
---

<Base title="YOSO — Arte digital, escultura y fotografía | Madrid">
  <Hero />

  <section id="intro" class="section container">
    <p class="eyebrow">El artista</p>
    <h2 style="margin-top:1rem; max-width:16ch;">Una arquitectura del&nbsp;ser</h2>
    <hr class="accent-rule" style="margin-top:1.5rem;" />
    <p class="lead" style="margin-top:2rem;">
      YOSO —&nbsp;Ambrosio José López González&nbsp;— traslada su mirada de arquitecto al
      arte digital, la escultura y la fotografía. Obra de carácter onírico que indaga en la
      identidad y la singularidad del individuo.
    </p>
  </section>
</Base>
