---
/**
 * Redirector de entrada (sitio estático): decide en cliente según sessionStorage.
 * - Primera visita de la sesión  → /entrada (splash gate cinematográfico).
 * - Ya entró antes               → /inicio (home principal), sin volver a ver el gate.
 * No lleva contenido propio: noindex + canónica a /inicio (la home indexable).
 * Ver splash-gate-skill.
 */
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>YOSO</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://yoso.art/inicio" />
    <meta name="theme-color" content="#0c0c0d" />
    <script is:inline>
      // Decide antes de pintar para evitar parpadeo. replace() no ensucia el historial.
      try {
        var entered = sessionStorage.getItem('yoso_entered');
        location.replace(entered ? '/inicio' : '/entrada');
      } catch (e) {
        location.replace('/inicio');
      }
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/inicio" /></noscript>
  </head>
  <body style="margin:0;background:#0c0c0d"></body>
</html>
