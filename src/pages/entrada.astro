---
/**
 * Splash gate cinematográfico (ver splash-gate-skill). Obra signature «Ecos» a
 * pantalla completa, marca YOSO y botón Entrar. Al pulsar: transición clip-path
 * y salto a /inicio. Documento propio (sin Header/Footer/Loader del sitio).
 * noindex; la home indexable es /inicio.
 */
import { Image } from 'astro:assets';
import { getObra } from '../lib/obras';

import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';

const signature = getObra('ecos'); // obra elegida por el cliente (960×1200)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>YOSO — Entrar</title>
    <meta name="description" content="Entrada a yoso.art — obra original del artista YOSO." />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://yoso.art/inicio" />
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body class="gate-body">
    <main class="gate" data-gate>
      <div class="gate__media">
        {signature && (
          <Image
            src={signature.image}
            alt=""
            widths={[640, 960, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        )}
        <div class="gate__scrim" aria-hidden="true"></div>
      </div>

      <header class="gate__top">
        <span class="gate__kicker">Galería · Madrid</span>
      </header>

      <div class="gate__center" data-gate-content>
        <p class="gate__eyebrow">Arte digital · Escultura · Fotografía</p>
        <h1 class="gate__name">YOSO</h1>
        <span class="gate__rule" aria-hidden="true"></span>
        <button type="button" class="gate__enter" data-gate-enter autofocus>
          <span>Entrar</span>
        </button>
      </div>

      <p class="gate__hint" aria-hidden="true">Obra: «Ecos»</p>
    </main>

    <style>
      .gate-body { margin: 0; background: var(--c-bg); cursor: default; overflow: hidden; }
      .gate { position: fixed; inset: 0; overflow: hidden; isolation: isolate; clip-path: inset(0 0 0% 0); }

      .gate__media { position: absolute; inset: 0; z-index: -2; }
      /* TODO(cliente): pendiente máster de «Ecos» en 2560×1440 mínimo. La actual
         es 960×1200 y se reescala (blanda) en pantallas grandes. Mientras tanto,
         oscurecemos ~18% en desktop para disimular la pérdida de nitidez. */
      .gate__media :global(img) {
        width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%;
        filter: brightness(0.82);
      }
      /* En móvil la obra encaja casi nativa: oscurecemos menos para no apagarla. */
      @media (max-width: 700px) {
        .gate__media :global(img) { filter: brightness(0.92); }
      }
      .gate__scrim {
        position: absolute; inset: 0; z-index: -1; pointer-events: none;
        /* «Ecos» es una obra muy luminosa: scrim fuerte para que el texto blanco
           y el botón lean con contraste AA. Vignette + oscurecido central + base. */
        background:
          radial-gradient(90% 70% at 50% 52%, rgba(12,12,13,.62) 0%, rgba(12,12,13,.30) 45%, transparent 75%),
          linear-gradient(to bottom, rgba(12,12,13,.55) 0%, rgba(12,12,13,.25) 28%, rgba(12,12,13,.45) 70%, rgba(12,12,13,.95) 100%);
      }

      .gate__top { position: absolute; top: clamp(1.25rem, 3.5vh, 2.25rem); left: 0; right: 0; text-align: center; }
      .gate__kicker {
        font-family: var(--font-sans); font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-wider); text-transform: uppercase; color: var(--c-ink-dim);
      }

      .gate__center {
        position: absolute; inset: 0; z-index: 2;
        display: grid; align-content: center; justify-items: center; gap: clamp(1rem, 2.2vh, 1.6rem);
        text-align: center; padding: 0 var(--gutter);
      }
      .gate__eyebrow {
        font-family: var(--font-sans); font-size: var(--fs-eyebrow); font-weight: var(--fw-med);
        letter-spacing: var(--ls-wider); text-transform: uppercase; color: var(--c-accent-2);
        opacity: 0; transform: translateY(12px); animation: gate-in .9s var(--ease-art) .15s forwards;
      }
      .gate__name {
        font-family: var(--font-display); font-weight: var(--fw-semi);
        font-size: clamp(4rem, 17vw, 13rem); line-height: .92; letter-spacing: .02em; color: var(--c-ink);
        margin: 0; text-shadow: 0 8px 60px rgba(0,0,0,.45);
        opacity: 0; transform: translateY(16px); animation: gate-in 1.1s var(--ease-art) .28s forwards;
      }
      .gate__rule {
        width: 1px; height: clamp(2rem, 6vh, 3.5rem);
        background: linear-gradient(var(--c-accent), transparent);
        opacity: 0; animation: gate-fade 1s var(--ease-art) .6s forwards;
      }
      .gate__enter {
        /* Acción principal: fondo translúcido oscuro para leer sobre cualquier obra. */
        background: rgba(12,12,13,.42); backdrop-filter: blur(6px);
        border: 1px solid rgba(244,241,234,.55); color: var(--c-ink);
        padding: 1rem 2.8rem; font-family: var(--font-sans); font-size: var(--fs-eyebrow); font-weight: var(--fw-med);
        letter-spacing: var(--ls-wider); text-transform: uppercase; cursor: pointer;
        opacity: 0; transform: translateY(12px); animation: gate-in 1s var(--ease-art) .72s forwards;
        transition: background var(--dur-1) var(--ease-art), color var(--dur-1) var(--ease-art), border-color var(--dur-1) var(--ease-art);
      }
      .gate__enter:hover, .gate__enter:focus-visible {
        background: var(--c-accent); color: var(--c-bg); border-color: var(--c-accent); outline: none;
      }

      .gate__hint {
        position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(1.25rem, 3.5vh, 2.25rem);
        text-align: center; font-family: var(--font-display); font-style: italic;
        font-size: var(--fs-sm); color: var(--c-ink-mute);
        opacity: 0; animation: gate-fade 1s var(--ease-art) .9s forwards;
      }

      @keyframes gate-in { to { opacity: 1; transform: translateY(0); } }
      @keyframes gate-fade { to { opacity: 1; } }

      @media (prefers-reduced-motion: reduce) {
        .gate__eyebrow, .gate__name, .gate__rule, .gate__enter, .gate__hint { animation: none; opacity: 1; transform: none; }
      }
    </style>

    <script>
      import gsap from 'gsap';

      const gate = document.querySelector<HTMLElement>('[data-gate]');
      const content = document.querySelector<HTMLElement>('[data-gate-content]');
      const btn = document.querySelector<HTMLButtonElement>('[data-gate-enter]');

      function enter() {
        // Marca la sesión: no repetir gate ni el loader de /inicio.
        try { sessionStorage.setItem('yoso_entered', '1'); sessionStorage.setItem('yoso_loaded', '1'); } catch (e) {}

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !gate) { window.location.href = '/inicio'; return; }

        // Transición cinematográfica: el contenido se va, la obra «se abre» y entramos.
        gsap.timeline({ onComplete: () => { window.location.href = '/inicio'; } })
          .to(content, { autoAlpha: 0, y: -24, duration: 0.45, ease: 'power2.in' })
          .to(gate, { clipPath: 'inset(0 0 100% 0)', duration: 0.9, ease: 'power4.inOut' }, '-=0.1');
      }

      btn?.addEventListener('click', enter);
      // Permite entrar con Enter/Espacio desde el teclado (el botón ya tiene autofocus).
      btn?.focus();
    </script>
  </body>
</html>
