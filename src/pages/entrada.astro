---
/**
 * Splash gate cinematográfico (ver splash-gate-skill). Documento propio (sin
 * Header/Footer/Loader del sitio). Carrusel de 3 obras a pantalla completa con
 * crossfade, marca YOSO, tagline editorial y slider TRAYECTORIA. Botón ENTRAR →
 * transición clip-path → /inicio. noindex; la home indexable es /inicio.
 */
import { Image } from 'astro:assets';
import { getObra } from '../lib/obras';

import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';

// Mismo carrusel que tenía el hero: Constellation → Sunset Fishing → Fishing in Gray.
const slides = ['constellation', 'sunset-fishing', 'fishing-in-gray']
  .map((s) => getObra(s))
  .filter((o): o is NonNullable<typeof o> => Boolean(o));

// Slider editorial de reconocimientos (fade ~3.5 s).
// TODO(cliente): confirmar/ampliar. Origen: datos de Marquee.astro.
const accolades = [
  'ART MADRID ’25',
  'Arte Laguna Prize · Venecia',
  'Torre NASDAQ · Times Square',
  'WISe.ART Excellence · Ginebra',
  'CICA Museum · Corea del Sur',
  'Sestante Art Prize · Lisboa',
  'Hybrid Art Fair · Madrid',
  'Premio Jaume Graells · Igualada',
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>YOSO — Entrar</title>
    <meta name="description" content="Entrada a yoso.art — obra original del artista YOSO." />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://yoso.art/inicio" />
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body class="gate-body">
    <main class="gate" data-gate>
      <div class="gate__media">
        <div class="gate__slides" data-gate-slides>
          {slides.map((o, i) => (
            <Image
              class={i === 0 ? 'is-active' : ''}
              src={o.image}
              alt=""
              widths={[768, 1280, 1920, 2560]}
              sizes="100vw"
              loading="eager"
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          ))}
        </div>
        <div class="gate__scrim" aria-hidden="true"></div>
      </div>

      <header class="gate__top"><span class="gate__kicker">Galería · Madrid</span></header>

      <div class="gate__content" data-gate-content>
        <p class="gate__eyebrow">Arte digital · Escultura · Fotografía</p>
        <h1 class="gate__name" data-gate-name>YOSO</h1>
        <p class="gate__tag">Obra original que nace del <em>sueño</em> y explora la <em>identidad humana</em>.</p>
        <button type="button" class="gate__enter" data-gate-enter autofocus><span>Entrar</span></button>
      </div>

      <div class="gate__accolades" data-accolades data-items={JSON.stringify(accolades)} aria-label="Reconocimientos">
        <span class="gate__accolades-label eyebrow">Trayectoria</span>
        <span class="gate__accolade" data-accolade aria-hidden="true">{accolades[0]}</span>
        <span class="visually-hidden">Reconocimientos: {accolades.join(', ')}.</span>
      </div>
    </main>

    <style>
      .gate-body { margin: 0; background: var(--c-bg); cursor: default; overflow: hidden; }
      .gate { position: fixed; inset: 0; overflow: hidden; isolation: isolate; clip-path: inset(0 0 0% 0); }

      .gate__media { position: absolute; inset: 0; z-index: -2; background: var(--c-bg); }
      .gate__slides { position: absolute; inset: 0; }
      .gate__slides :global(img) {
        position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center;
        opacity: 0; transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .gate__slides :global(img.is-active) { opacity: 1; }

      /* Scrim continuo (legibilidad del texto blanco sobre obras de brillo variable) */
      .gate__scrim { position: absolute; inset: 0; z-index: -1; pointer-events: none;
        background: linear-gradient(to bottom,
          rgba(12,12,13,.62) 0%, rgba(12,12,13,.42) 30%, rgba(12,12,13,.46) 62%, rgba(12,12,13,.92) 100%);
      }

      .gate__top { position: absolute; top: clamp(1.25rem, 3.5vh, 2.25rem); left: 0; right: 0; text-align: center; }
      .gate__kicker { font-family: var(--font-sans); font-size: var(--fs-eyebrow); letter-spacing: var(--ls-wider); text-transform: uppercase; color: var(--c-ink-dim); }

      .gate__content { position: absolute; inset: 0; z-index: 2; display: grid; align-content: center; justify-items: center; gap: clamp(1rem, 2.2vh, 1.6rem); text-align: center; padding: 0 var(--gutter); }
      .gate__eyebrow { font-family: var(--font-sans); font-size: var(--fs-eyebrow); font-weight: var(--fw-med); letter-spacing: var(--ls-wider); text-transform: uppercase; color: var(--c-accent-2); opacity: 0; transform: translateY(12px); animation: gate-in .9s var(--ease-art) .15s forwards; }
      .gate__name { font-family: var(--font-display); font-weight: var(--fw-semi); font-size: clamp(4rem, 17vw, 13rem); line-height: .9; letter-spacing: .03em; color: var(--c-ink); margin: 0; text-shadow: 0 10px 70px rgba(0,0,0,.55); overflow: hidden; visibility: hidden; }
      .gate__name :global(.char) { display: inline-block; will-change: transform; }
      .gate__tag { font-family: var(--font-display); font-weight: 300; font-size: var(--fs-lead); letter-spacing: 0.015em; line-height: 1.45; color: rgba(244,241,234,.9); max-width: 36ch; margin-inline: auto; text-shadow: 0 2px 24px rgba(0,0,0,.5); opacity: 0; transform: translateY(12px); animation: gate-in 1s var(--ease-art) .5s forwards; }
      .gate__tag em { font-style: italic; }
      .gate__enter { margin-top: clamp(.5rem, 1.5vh, 1rem); background: rgba(12,12,13,.42); backdrop-filter: blur(6px); border: 1px solid rgba(244,241,234,.55); color: var(--c-ink); padding: 1rem 2.8rem; font-family: var(--font-sans); font-size: var(--fs-eyebrow); font-weight: var(--fw-med); letter-spacing: var(--ls-wider); text-transform: uppercase; cursor: pointer; opacity: 0; transform: translateY(12px); animation: gate-in 1s var(--ease-art) .85s forwards; transition: background var(--dur-1) var(--ease-art), color var(--dur-1) var(--ease-art), border-color var(--dur-1) var(--ease-art); }
      .gate__enter:hover, .gate__enter:focus-visible { background: var(--c-accent); color: var(--c-bg); border-color: var(--c-accent); outline: none; }

      .gate__accolades { position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(2rem, 5vh, 3.5rem); display: grid; justify-items: center; gap: var(--sp-2); padding-inline: var(--gutter); opacity: 0; animation: gate-in 1s var(--ease-art) 1s forwards; }
      .gate__accolades-label { color: var(--c-ink-mute); }
      .gate__accolade { font-family: var(--font-display); font-style: italic; font-size: var(--fs-lead); color: rgba(244,241,234,.94); min-height: 1.4em; transition: opacity .5s var(--ease-art), transform .5s var(--ease-art); }

      @keyframes gate-in { to { opacity: 1; transform: translateY(0); } }

      @media (prefers-reduced-motion: reduce) {
        .gate__eyebrow, .gate__name, .gate__tag, .gate__enter, .gate__accolades { animation: none; opacity: 1; transform: none; }
        .gate__name { visibility: visible; }
        .gate__slides :global(img) { transition: none; }
      }
    </style>

    <script>
      import gsap from 'gsap';
      import { SplitText } from 'gsap/SplitText';
      gsap.registerPlugin(SplitText);

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal del nombre (sin loader en el gate → directo al cargar).
      function revealName() {
        const name = document.querySelector<HTMLElement>('[data-gate-name]');
        if (!name) return;
        name.style.visibility = 'visible';
        if (reduce) return;
        const split = new SplitText(name, { type: 'chars' });
        gsap.from(split.chars, { yPercent: 120, duration: 1.1, ease: 'power4.out', stagger: 0.07, delay: 0.3 });
      }

      // Carrusel crossfade 5 s + pausa en pestaña oculta + reduced-motion fija la 1ª.
      function initCarousel() {
        const wrap = document.querySelector<HTMLElement>('[data-gate-slides]');
        if (!wrap) return;
        const imgs = Array.from(wrap.querySelectorAll<HTMLImageElement>('img'));
        if (reduce || imgs.length < 2) return;
        let i = 0, timer = 0;
        const advance = () => { const n = (i + 1) % imgs.length; imgs[i].classList.remove('is-active'); imgs[n].classList.add('is-active'); i = n; };
        const start = () => { if (!timer) timer = window.setInterval(advance, 5000); };
        const stop = () => { if (timer) { clearInterval(timer); timer = 0; } };
        start();
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      }

      // Slider TRAYECTORIA (fade ~3.5 s).
      function initAccolades() {
        const wrap = document.querySelector<HTMLElement>('[data-accolades]');
        const el = document.querySelector<HTMLElement>('[data-accolade]');
        if (!wrap || !el) return;
        let items: string[] = [];
        try { items = JSON.parse(wrap.dataset.items || '[]'); } catch {}
        if (reduce || items.length < 2) return;
        let i = 0;
        window.setInterval(() => {
          const n = (i + 1) % items.length;
          el.style.opacity = '0'; el.style.transform = 'translateY(6px)';
          window.setTimeout(() => { el.textContent = items[n]; el.style.opacity = ''; el.style.transform = ''; i = n; }, 500);
        }, 3500);
      }

      // ENTRAR → marca sesión + transición clip-path → /inicio.
      function enter() {
        try { sessionStorage.setItem('yoso_entered', '1'); sessionStorage.setItem('yoso_loaded', '1'); } catch (e) {}
        const gate = document.querySelector<HTMLElement>('[data-gate]');
        if (reduce || !gate) { window.location.href = '/inicio'; return; }
        gsap.timeline({ onComplete: () => { window.location.href = '/inicio'; } })
          .to(['[data-gate-content]', '[data-accolades]'], { autoAlpha: 0, y: -24, duration: 0.45, ease: 'power2.in' })
          .to(gate, { clipPath: 'inset(0 0 100% 0)', duration: 0.9, ease: 'power4.inOut' }, '-=0.1');
      }

      const btn = document.querySelector<HTMLButtonElement>('[data-gate-enter]');
      btn?.addEventListener('click', enter);
      btn?.focus();
      revealName();
      initCarousel();
      initAccolades();
    </script>
  </body>
</html>
