---
import Base from '../../layouts/Base.astro';
import RefikGrid from '../../components/RefikGrid.astro';
import { obras, cats } from '../../lib/obras';

// Items para la galería Refik (color de acento por obra + ruta a la ficha).
const items = obras.map((o) => ({
  slug: o.slug,
  title: o.title,
  catLabel: o.catLabel,
  cat: o.cat,
  image: o.image,
  accentColor: o.accentColor,
  accentGlow: o.accentGlow,
  href: `/obras/${o.slug}`,
}));
---

<Base
  title="Obras — YOSO | Catálogo de arte digital, escultura y fotografía"
  description="Catálogo completo de la obra de YOSO: arte digital, escultura y fotografía. Filtra por disciplina y descubre cada pieza."
>
  <section class="obras section">
    <div class="container">
      <header class="obras__head">
        <p class="eyebrow">Catálogo · {obras.length} obras</p>
        <h1>Obras</h1>
        <hr class="accent-rule" style="margin-top:1.5rem;" />
      </header>

      <div class="obras__filters" role="group" aria-label="Filtrar por disciplina">
        {cats.map((c) => (
          <button
            type="button"
            class="filter"
            data-filter={c.value}
            aria-pressed={c.value === 'all' ? 'true' : 'false'}
          >{c.label}</button>
        ))}
      </div>

      <RefikGrid items={items} />
    </div>
  </section>
</Base>

<style>
  .obras__head { margin-bottom: var(--sp-7); }

  .obras__filters { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-bottom: var(--sp-7); }
  .filter {
    background: none; border: 1px solid var(--c-line); color: var(--c-ink-dim);
    padding: 0.5rem 1.1rem; cursor: pointer; border-radius: 999px;
    font-size: var(--fs-eyebrow); letter-spacing: var(--ls-wide); text-transform: uppercase;
    transition: color var(--dur-1) var(--ease-art), border-color var(--dur-1) var(--ease-art), background var(--dur-1) var(--ease-art);
  }
  .filter:hover { color: var(--c-ink); border-color: var(--c-ink-dim); }
  .filter[aria-pressed='true'] { color: var(--c-bg); background: var(--c-accent-2); border-color: var(--c-accent-2); }
</style>

<script>
  // Filtros por disciplina: operan sobre las celdas de RefikGrid (.rgrid__cell[data-cat]).
  // Aceptan prefiltro por URL (?d=digital|escultura|foto) desde las cards de /inicio.
  function initObrasFilters() {
    const grid = document.querySelector('[data-rgrid]');
    if (!grid) return;
    const cells = Array.from(grid.querySelectorAll<HTMLElement>('.rgrid__cell'));
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));

    const apply = (val: string | undefined) => {
      filters.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.filter || 'all') === (val || 'all'))));
      cells.forEach((c) => {
        const show = !val || val === 'all' || c.dataset.cat === val;
        c.hidden = !show;
        if (show && !c.classList.contains('is-in')) c.classList.add('is-in');
      });
    };

    filters.forEach((btn) => btn.addEventListener('click', () => apply(btn.dataset.filter)));

    // Prefiltro desde la URL (?d=...). Solo valores válidos; si no, "all".
    const d = new URLSearchParams(location.search).get('d');
    if (d && filters.some((b) => b.dataset.filter === d)) apply(d);
  }
  document.addEventListener('astro:page-load', initObrasFilters);
</script>
