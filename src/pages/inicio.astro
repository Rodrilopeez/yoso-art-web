---
/**
 * Home = puerta de selección por disciplina (patrón cyrcle.com/art). Tres cards
 * a ~100vh (Arte digital · Escultura · Fotografía); cada una enlaza a /obras
 * prefiltrado por su disciplina. Nav simétrica habitual + CTA secundario discreto.
 * Lenguaje cinematográfico: negro absoluto, Fraunces, glow por disciplina,
 * motion editorial cubic-bezier(0.22,1,0.36,1).
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getObra } from '../lib/obras';

// Obra de fondo + color de marca por disciplina (validado con el cliente).
const cards = [
  { cat: 'digital', label: 'Arte digital', obra: getObra('dream-of-red-wave-i'), accent: '#d8a13a' },
  { cat: 'escultura', label: 'Escultura', obra: getObra('ecos'), accent: '#cd3a32' },
  { cat: 'foto', label: 'Fotografía', obra: getObra('fishing-in-gray'), accent: '#b9bcc0' },
].filter((c) => c.obra);
---

<Base
  title="YOSO — Arte digital, escultura y fotografía | Madrid"
  description="Obra original del artista YOSO (Ambrosio José López González): arte digital, escultura y fotografía de carácter onírico. Galería contemporánea en Madrid."
>
  <section class="disc" data-disc aria-label="Disciplinas">
    <ul class="disc__grid">
      {cards.map((c) => (
        <li class="disc__cell" style={`--accent:${c.accent}`}>
          <a class="disc__card" href={`/obras?d=${c.cat}`} data-disc-card aria-label={`Ver obra de ${c.label.toLowerCase()}`}>
            <span class="disc__media">
              <Image src={c.obra!.image} alt="" widths={[480, 768, 1067, 1600]} sizes="(max-width: 860px) 94vw, 32vw" loading="eager" />
            </span>
            <span class="disc__label">
              <span class="disc__title" data-disc-title>{c.label}</span>
              <span class="disc__go">Ver obra <span class="disc__go-arrow" aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="disc__all">
      <a href="/obras">Ver todo el catálogo →</a>
    </p>
  </section>
</Base>

<style>
  .disc { height: 100svh; min-height: 560px; display: grid; grid-template-rows: 1fr auto; background: var(--c-bg); }

  .disc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; min-height: 0; }
  /* Sin overflow:hidden en la celda para que el crecimiento 1.03 se vea; el recorte
     de la obra vive en .disc__media. */
  .disc__cell { position: relative; transition: opacity var(--dur-2) var(--ease-art); }

  /* ESTRUCTURA UNIFORME en las 3 cards: división vertical FIJA e idéntica
     (obra 62% / info 38%) independientemente de la proporción de cada obra → títulos
     y «Ver obra» alineados exactamente a la misma altura en las tres.
     TODO(cliente): pendiente máster 2560×1440 mínimo por disciplina; las obras
     topan en ~1200px y se ablandan en pantallas 4K. */
  .disc__card { position: absolute; inset: 0; display: grid; grid-template-rows: 62% 38%; background: var(--c-bg); isolation: isolate; transform-origin: center; transition: transform var(--dur-2) var(--ease-art), box-shadow var(--dur-2) var(--ease-art); }
  .disc__media { position: relative; overflow: hidden; min-height: 0; }
  .disc__media :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center; /* center center en las 3 */
    filter: brightness(.82) contrast(1.06) saturate(1.05); /* nitidez perceptual */
    transition: filter var(--dur-2) var(--ease-art);
  }
  .disc__media::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    box-shadow: inset 0 0 110px 18px rgba(12,12,13,.5); } /* viñeta enmascara blur de borde */

  /* Banda info (38%): negro absoluto, título arriba y «Ver obra» abajo, centrados */
  .disc__label { display: grid; align-content: center; justify-items: center; gap: clamp(.9rem, 2vh, 1.5rem); text-align: center; padding: var(--sp-5) var(--gutter); background: var(--c-bg); }
  .disc__title { font-family: var(--font-display); font-size: clamp(1.8rem, 3.2vw, 2.9rem); line-height: 1.05; color: var(--c-ink); transition: color var(--dur-1) var(--ease-art); }
  /* «Ver obra» VISIBLE en las 3 por defecto (hueso 70%); al hover vira al acento */
  .disc__go { display: inline-flex; align-items: center; gap: .5em; font-size: var(--fs-eyebrow); letter-spacing: var(--ls-wide); text-transform: uppercase; color: rgba(244,241,234,.7); transition: color var(--dur-1) var(--ease-art); }
  .disc__go-arrow { transition: transform var(--dur-1) var(--ease-art); }

  /* Activo (hover desktop / tap móvil): card crece 1.03 + glow + texto al acento + flecha */
  .disc__cell.is-active { z-index: 3; }
  .disc__cell.is-active .disc__card { transform: scale(1.03); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 55%, transparent), 0 0 70px color-mix(in srgb, var(--accent) 45%, transparent); }
  .disc__cell.is-active .disc__media :global(img) { filter: brightness(.98) contrast(1.07) saturate(1.08); }
  .disc__cell.is-active .disc__title { color: var(--accent); }
  .disc__cell.is-active .disc__go { color: var(--accent); }
  .disc__cell.is-active .disc__go-arrow { transform: translateX(5px); }
  /* Las otras dos cards se atenúan (opacity .5) para reforzar la atención */
  .disc[data-focusing] .disc__cell:not(.is-active) { opacity: .5; }

  .disc__all { text-align: center; padding: clamp(.9rem, 2.5vh, 1.4rem); }
  .disc__all a { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-wide); text-transform: uppercase; color: #c3bdb0; }
  .disc__all a:hover, .disc__all a:focus-visible { color: var(--c-ink); }

  /* Móvil: cards apiladas (54svh), misma estructura obra/info; tap-to-reveal */
  @media (max-width: 860px) {
    .disc { height: auto; min-height: 0; }
    .disc__grid { grid-template-columns: 1fr; }
    .disc__cell { height: 54svh; min-height: 340px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .disc__cell, .disc__card, .disc__media :global(img), .disc__title, .disc__go, .disc__go-arrow { transition: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(SplitText);

  function initDisc() {
    const disc = document.querySelector<HTMLElement>('[data-disc]');
    if (!disc) return;
    const cells = Array.from(disc.querySelectorAll<HTMLElement>('.disc__cell'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;

    // Pre-split de los títulos para revelarlos por carácter al activar (words,chars
    // mantiene las palabras enteras). En reduced-motion no se parte.
    const splits = new Map<HTMLElement, SplitText>();
    if (!reduce) {
      cells.forEach((cell) => {
        const t = cell.querySelector<HTMLElement>('[data-disc-title]');
        if (t) splits.set(cell, new SplitText(t, { type: 'words,chars' }));
      });
    }
    const revealTitle = (cell: HTMLElement) => {
      const s = splits.get(cell);
      if (s) gsap.fromTo(s.chars, { yPercent: 110 }, { yPercent: 0, stagger: 0.02, duration: 0.5, ease: 'power4.out', overwrite: true });
    };

    const setActive = (cell: HTMLElement | null) => {
      cells.forEach((c) => c.classList.toggle('is-active', c === cell));
      disc.toggleAttribute('data-focusing', !!cell);
      if (cell) revealTitle(cell);
    };

    if (!coarse) {
      cells.forEach((cell) => {
        cell.addEventListener('pointerenter', () => setActive(cell));
        cell.addEventListener('pointerleave', () => setActive(null));
      });
    } else {
      // Táctil: 1er tap revela (glow + «Ver obra»); 2º tap (ya activa) navega.
      cells.forEach((cell) => {
        const link = cell.querySelector<HTMLAnchorElement>('.disc__card');
        link?.addEventListener('click', (e) => {
          if (!cell.classList.contains('is-active')) { e.preventDefault(); setActive(cell); }
        });
      });
    }
  }
  document.addEventListener('astro:page-load', initDisc);
</script>
