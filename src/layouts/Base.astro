---
/**
 * Layout base del sitio. Centraliza el <head> con los fundamentos SEO
 * (title único, meta description, canonical, Open Graph) — aplica de origen
 * las recomendaciones SEO §1, §3, §5 y §Meta de la auditoría.
 */
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Obra original del artista YOSO (Ambrosio López González): arte digital, escultura y fotografía de carácter onírico. Galería contemporánea en Madrid.',
  image = '/og/og-yoso.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Tipografías self-hosted (Fontsource) + sistema de diseño
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import Cursor from '../components/Cursor.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0c0c0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph / Twitter (SEO §3) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="YOSO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yoso_arts" />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
  </head>
  <body>
    <span id="top" aria-hidden="true"></span>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Loader />
    <Cursor />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Smooth scroll (Lenis) sincronizado con GSAP ScrollTrigger.
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lenis: any = null;
      const tick = (t: number) => lenis?.raf(t * 1000);

      function start() {
        if (reduce || lenis) return;
        lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add(tick);
        gsap.ticker.lagSmoothing(0);
        (window as any).__lenis = lenis;
      }
      function stop() {
        if (!lenis) return;
        gsap.ticker.remove(tick);
        lenis.destroy();
        lenis = null;
      }
      document.addEventListener('astro:page-load', () => { start(); ScrollTrigger.refresh(); });
      document.addEventListener('astro:before-swap', stop);
    </script>
  </body>
</html>
