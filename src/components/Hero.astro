---
/**
 * Hero de /inicio: UNA sola obra a pantalla completa (object-fit: cover), sin
 * carrusel ni transiciones internas (eso causaba el «hero partido en franjas»:
 * el canvas WebGL se dimensionaba a ~150px y se superponía como banda al fondo).
 * Composición editorial centrada (YOSO) con scrim continuo POR ENCIMA de la obra
 * para legibilidad, y slider editorial de reconocimientos.
 *
 * TODO(cliente): la obra de fondo se puede cambiar por la que prefieras o por un
 * máster de mayor resolución (las de assets rondan ~1200px → blandas en 4K).
 */
import { Image } from 'astro:assets';
import { getObra } from '../lib/obras';

const heroObra = getObra('identity'); // obra signature de portada (editable)

// Reconocimientos para el slider editorial del hero (fade entre items, ~3.5 s).
// TODO(cliente): confirmar y/o ampliar. Origen: datos ya presentes en Marquee.astro.
const accolades = [
  'ART MADRID ’25',
  'Arte Laguna Prize · Venecia',
  'Torre NASDAQ · Times Square',
  'WISe.ART Excellence · Ginebra',
  'CICA Museum · Corea del Sur',
  'Sestante Art Prize · Lisboa',
  'Hybrid Art Fair · Madrid',
  'Premio Jaume Graells · Igualada',
];
---

<section class="hero" aria-label="YOSO — obra original">
  <div class="hero__media">
    {heroObra && (
      <Image
        class="hero__img"
        src={heroObra.image}
        alt=""
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content">
    <p class="hero__eyebrow eyebrow">Arte digital · Escultura · Fotografía</p>
    <h1 class="hero__name" data-hero-name>YOSO</h1>
    <p class="hero__tag">Obra original que nace del sueño y explora la identidad humana.</p>
  </div>

  <!-- Slider editorial de reconocimientos (fade entre items ~3.5 s) -->
  <div class="hero__accolades" data-accolades data-items={JSON.stringify(accolades)} aria-label="Reconocimientos">
    <span class="hero__accolades-label eyebrow">Trayectoria</span>
    <span class="hero__accolade" data-accolade aria-hidden="true">{accolades[0]}</span>
    <span class="visually-hidden">Reconocimientos: {accolades.join(', ')}.</span>
  </div>

  <a href="#intro" class="hero__scroll" aria-label="Desplázate para descubrir">
    <span>Descubrir</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  /* Una sola obra a pantalla completa, composición editorial centrada */
  .hero { position: relative; height: 100svh; min-height: 600px; display: grid; place-items: center; text-align: center; overflow: hidden; isolation: isolate; }

  .hero__media { position: absolute; inset: 0; z-index: -2; background: var(--c-bg); }
  .hero__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }

  /* Scrim CONTINUO por encima de la obra entera (no parte la composición).
     Velo vertical suave: más oscuro arriba (nav) y abajo (slider), legible en el centro. */
  .hero__scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom,
      rgba(12,12,13,.62) 0%,
      rgba(12,12,13,.42) 30%,
      rgba(12,12,13,.46) 62%,
      rgba(12,12,13,.92) 100%);
  }

  .hero__content { position: relative; z-index: 2; padding: 0 var(--gutter); width: 100%; max-width: 1200px; display: grid; justify-items: center; gap: clamp(.6rem, 1.5vh, 1.1rem); }
  .hero__eyebrow { color: var(--c-accent-2); opacity: 0; transform: translateY(12px); animation: hero-fade var(--dur-2) var(--ease-art) 0.1s forwards; }
  .hero__name { font-size: var(--fs-mega); font-weight: var(--fw-semi); line-height: 0.9; letter-spacing: 0.04em; margin: clamp(0.25rem,1vw,.75rem) 0; overflow: hidden; visibility: hidden; text-shadow: 0 10px 70px rgba(0,0,0,.55); }
  .hero__name :global(.char) { display: inline-block; will-change: transform; }
  .hero__tag { font-size: var(--fs-lead); color: rgba(244,241,234,.88); max-width: 34ch; margin-inline: auto; opacity: 0; transform: translateY(12px); animation: hero-fade var(--dur-2) var(--ease-art) 0.5s forwards; text-shadow: 0 2px 24px rgba(0,0,0,.5); }

  /* Slider editorial de reconocimientos (fade entre items) */
  .hero__accolades { position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(3.2rem, 8vh, 6rem); display: grid; justify-items: center; gap: var(--sp-2); padding-inline: var(--gutter); opacity: 0; animation: hero-fade var(--dur-2) var(--ease-art) 0.9s forwards; }
  .hero__accolades-label { color: var(--c-ink-mute); }
  .hero__accolade { font-family: var(--font-display); font-style: italic; font-size: var(--fs-lead); color: rgba(244,241,234,.94); min-height: 1.4em; transition: opacity .5s var(--ease-art), transform .5s var(--ease-art); }

  .hero__scroll { position: absolute; z-index: 2; right: var(--gutter); bottom: clamp(2.4rem,6vh,4rem); display: inline-flex; flex-direction: column; align-items: center; gap: var(--sp-3); font-size: var(--fs-eyebrow); letter-spacing: var(--ls-wide); text-transform: uppercase; color: var(--c-ink-dim); }
  .hero__scroll-line { width: 1px; height: 56px; background: linear-gradient(var(--c-accent), transparent); transform-origin: top; animation: scroll-pulse 2.4s var(--ease-in-out) infinite; }
  .hero__scroll:hover { color: var(--c-ink); }

  @keyframes hero-fade { to { opacity: 1; transform: translateY(0); } }
  @keyframes scroll-pulse { 0%,100% { transform: scaleY(0.4); opacity: .5; } 50% { transform: scaleY(1); opacity: 1; } }

  @media (max-width: 600px) { .hero__scroll { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__name { visibility: visible; }
    .hero__scroll-line { animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(SplitText);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initName() {
    const name = document.querySelector<HTMLElement>('[data-hero-name]');
    if (!name) return;
    name.style.visibility = 'visible';
    if (reduce) return;
    const split = new SplitText(name, { type: 'chars' });
    gsap.from(split.chars, { yPercent: 120, duration: 1.1, ease: 'power4.out', stagger: 0.07, delay: 0.25 });
  }

  // Slider editorial de reconocimientos: fade entre items cada ~3.5 s.
  function initAccolades() {
    const wrap = document.querySelector<HTMLElement>('[data-accolades]');
    const el = document.querySelector<HTMLElement>('[data-accolade]');
    if (!wrap || !el) return;
    let items: string[] = [];
    try { items = JSON.parse(wrap.dataset.items || '[]'); } catch {}
    if (reduce || items.length < 2) return; // reduced-motion: queda el primero fijo
    let i = 0;
    const id = window.setInterval(() => {
      const next = (i + 1) % items.length;
      el.style.opacity = '0'; el.style.transform = 'translateY(6px)';
      window.setTimeout(() => {
        el.textContent = items[next];
        el.style.opacity = ''; el.style.transform = '';
        i = next;
      }, 500); // coincide con la transición CSS del .hero__accolade
    }, 3500);
    document.addEventListener('astro:before-swap', () => clearInterval(id), { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    // El nombre se revela cuando el loader/intro termina (evita animar bajo el loader).
    if ((window as any).__yosoIntroDone) initName();
    else document.addEventListener('yoso:loaded', initName, { once: true });
    initAccolades();
  });
</script>
